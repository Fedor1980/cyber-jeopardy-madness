# NexusOS Documentation Platform - Environment Variables
# Copy this file to .env and fill in actual values (NEVER commit .env)

# Build Configuration
NEXUSOS_VERSION=1.0.0
NEXUSOS_LICENSE_MODE=community  # community | pro | enterprise
BUILD_ENV=development  # development | staging | production

# Deployment Targets (set to 'true' to enable)
DEPLOY_GITBOOK=false
DEPLOY_GITHUB_PAGES=false
DEPLOY_CONFLUENCE=false
DEPLOY_NOTION=false

# GitBook Deployment
GITBOOK_REPO_URL=https://github.com/your-org/nexusos-docs-gitbook.git
GITBOOK_DEPLOY_KEY=  # Path to SSH private key or leave empty for default

# GitHub Pages
GITHUB_PAGES_REPO=your-org/nexusos-docs
GITHUB_DEPLOY_TOKEN=  # GitHub Personal Access Token with repo scope

# Confluence
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_SPACE_KEY=NEXUSOS
CONFLUENCE_USERNAME=  # Confluence user email
CONFLUENCE_API_TOKEN=  # Confluence API token

# Notion (Optional)
NOTION_API_TOKEN=  # Notion integration token
NOTION_DATABASE_ID=  # Target database/page ID

# Notifications
SLACK_WEBHOOK_URL=  # Slack incoming webhook for deployment notifications
TEAMS_WEBHOOK_URL=  # Microsoft Teams webhook (optional)

# Analytics (Optional - disabled by default)
ENABLE_ANALYTICS=false
ANALYTICS_ENDPOINT=  # Custom analytics endpoint

# Security
SECRET_SCANNING_ENABLED=true
TRUFFLEHOG_VERSION=latest

# CI/CD
CI=false  # Auto-set to true in GitHub Actions
DRY_RUN=false  # Set to true for dry-run deployments

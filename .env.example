# =============================================================================
# CYBER JEOPARDY MADNESS - ENVIRONMENT CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
NODE_ENV=development
API_VERSION=v1
PORT=3001

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cyber_jeopardy
DB_USER=postgres
DB_PASSWORD=your_secure_database_password_here_min_16_chars

# Database Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=10000
DB_CONNECTION_TIMEOUT=2000

# -----------------------------------------------------------------------------
# JWT Authentication & Security
# -----------------------------------------------------------------------------
# CRITICAL: Change these in production to secure random strings (min 32 chars)
JWT_SECRET=change_this_to_a_secure_random_string_minimum_32_characters_long_REQUIRED
JWT_REFRESH_SECRET=change_this_to_a_different_secure_random_string_minimum_32_chars_REQUIRED
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Session Secret
SESSION_SECRET=another_secure_random_string_for_sessions_min_32_characters

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost,http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# AI Integration (Optional)
# -----------------------------------------------------------------------------
# OpenAI API Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=200

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=200

# AI Hint Caching
AI_CACHE_ENABLED=true
AI_CACHE_TTL=86400

# -----------------------------------------------------------------------------
# WebSocket Configuration
# -----------------------------------------------------------------------------
WS_PING_TIMEOUT=60000
WS_PING_INTERVAL=25000
WS_RECONNECTION_ATTEMPTS=5

# -----------------------------------------------------------------------------
# File Upload & Storage
# -----------------------------------------------------------------------------
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d

# -----------------------------------------------------------------------------
# Email Configuration (Optional - for notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@cyberjeopardy.com

# -----------------------------------------------------------------------------
# Deployment & Production Settings
# -----------------------------------------------------------------------------
PRODUCTION_URL=https://your-domain.com
ENABLE_HTTPS=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# CDN Configuration (Optional)
CDN_URL=

# -----------------------------------------------------------------------------
# Analytics & Monitoring (Optional)
# -----------------------------------------------------------------------------
ENABLE_ANALYTICS=false
ANALYTICS_ID=

# Sentry Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_AI_HINTS=true
ENABLE_WEBSOCKETS=true
ENABLE_LEADERBOARD=true
ENABLE_EMAIL_CAPTURE=true
ENABLE_AUDIT_LOGS=true

# -----------------------------------------------------------------------------
# Game Configuration
# -----------------------------------------------------------------------------
DEFAULT_INDUSTRY_PACK=federal-credit-union
DEFAULT_TIMER_SECONDS=30
MAX_TEAMS=4
MIN_TEAMS=2

# -----------------------------------------------------------------------------
# Frontend Configuration (for .env in frontend/)
# -----------------------------------------------------------------------------
# These should be duplicated in frontend/.env
VITE_API_URL=http://localhost:3001/api/v1
VITE_WS_URL=http://localhost:3001
VITE_APP_NAME=Cyber Jeopardy Madness
VITE_APP_VERSION=2.0.0
VITE_ENABLE_ANIMATIONS=true
VITE_ENABLE_SOUND=true

# -----------------------------------------------------------------------------
# Security Headers
# -----------------------------------------------------------------------------
ENABLE_HELMET=true
ENABLE_CSRF_PROTECTION=true

# -----------------------------------------------------------------------------
# Backup & Maintenance
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Compliance & Industry Settings
# -----------------------------------------------------------------------------
COMPLIANCE_MODE=strict
INDUSTRY_FOCUS=finance,healthcare,federal
ENABLE_COMPLIANCE_REPORTS=true

# =============================================================================
# NOTES:
# 1. Never commit this file with real secrets to version control
# 2. Generate strong random secrets for JWT_SECRET and JWT_REFRESH_SECRET
# 3. Use environment-specific values for different deployments
# 4. Ensure DB_PASSWORD is strong (16+ chars, mixed case, numbers, symbols)
# 5. Configure CORS_ORIGIN properly to prevent security issues
# 6. AI API keys are optional but enable enhanced hint features
# 7. Update PRODUCTION_URL when deploying to production
# =============================================================================

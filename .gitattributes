# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.md    text eol=lf
*.sql   text eol=lf

# Shell scripts
*.sh    text eol=lf
*.bash  text eol=lf

# Windows scripts
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Configuration files
*.yml   text eol=lf
*.yaml  text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Documentation
LICENSE text eol=lf
README* text eol=lf
CONTRIBUTING* text eol=lf
CHANGELOG* text eol=lf

# Images
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text

# Audio/Video
*.mp3   binary
*.wav   binary
*.mp4   binary
*.webm  binary

# Fonts
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary

# Archives
*.zip   binary
*.tar   binary
*.gz    binary

# Export diff output for PRs
.gitattributes export-ignore
.github export-ignore

# EditorConfig for NexusOS Documentation Platform
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = 120

[*.{js,mjs,ts,json,yaml,yml}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.mmd]
indent_size = 2

[*.{html,css}]
indent_size = 2

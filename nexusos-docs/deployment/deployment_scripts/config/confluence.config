# NexusOS Documentation Platform - Confluence Configuration

# Confluence Server Details
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_SPACE_KEY=NEXUSOS
CONFLUENCE_PARENT_PAGE_TITLE=Documentation

# Authentication
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=

# Deployment Options
CONFLUENCE_CREATE_SPACE=false
CONFLUENCE_UPDATE_EXISTING=true
CONFLUENCE_DELETE_ORPHANED=false

# Content Options
CONFLUENCE_INCLUDE_TOC=true
CONFLUENCE_INCLUDE_BREADCRUMBS=true
CONFLUENCE_PAGE_LABELS=nexusos,documentation,api

# Advanced
CONFLUENCE_API_VERSION=v2
CONFLUENCE_BATCH_SIZE=10
CONFLUENCE_RATE_LIMIT_DELAY=1  # seconds between requests

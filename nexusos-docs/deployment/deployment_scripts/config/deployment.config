# NexusOS Documentation Platform - Deployment Configuration
# Main configuration file for all deployment targets

# Version
NEXUSOS_VERSION=1.0.0

# Build Configuration
BUILD_ENV=production
SOURCE_DIR=docs
DIST_DIR=dist

# Deployment Targets (true/false)
DEPLOY_CONFLUENCE=false
DEPLOY_GITBOOK=false
DEPLOY_GITHUB_PAGES=false
DEPLOY_NOTION=false

# Retry Configuration
MAX_RETRIES=4
RETRY_DELAY=2

# Notification Settings
ENABLE_NOTIFICATIONS=true
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Logging
LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=json  # json, text

# Security
ENABLE_SECRET_SCANNING=true
FAIL_ON_SECRET_LEAK=true

# Performance
PARALLEL_DEPLOYMENTS=false
DEPLOYMENT_TIMEOUT=600  # seconds

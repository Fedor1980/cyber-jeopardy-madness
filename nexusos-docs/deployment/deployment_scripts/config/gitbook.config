# NexusOS Documentation Platform - GitBook Configuration

# GitBook Repository
GITBOOK_REPO_URL=https://github.com/your-org/nexusos-docs-gitbook.git
GITBOOK_BRANCH=main
GITBOOK_DEPLOY_KEY=

# GitBook Settings
GITBOOK_TITLE=NexusOS Documentation
GITBOOK_DESCRIPTION=Complete documentation suite for NexusOS
GITBOOK_AUTHOR=NexusOS Team

# Structure
GITBOOK_AUTO_SUMMARY=true
GITBOOK_INCLUDE_README=true
GITBOOK_ROOT_DIR=./

# Theme & Customization
GITBOOK_THEME=default
GITBOOK_LOGO_URL=
GITBOOK_FAVICON_URL=

# Plugins
GITBOOK_PLUGINS=search,fontsettings,sharing,livereload

# Advanced
GITBOOK_GIT_USER_NAME=NexusOS Deploy Bot
GITBOOK_GIT_USER_EMAIL=deploy@nexusos.io
GITBOOK_COMMIT_MESSAGE=Deploy documentation - %DATE%

# NexusOS Documentation Platform - GitHub Pages Configuration

# GitHub Repository
GITHUB_PAGES_REPO=your-org/nexusos-docs
GITHUB_DEPLOY_TOKEN=
PAGES_BRANCH=gh-pages

# Custom Domain
GITHUB_PAGES_CNAME=docs.nexusos.io

# Build Options
GITHUB_PAGES_SOURCE=dist/html
GITHUB_PAGES_INCLUDE_NOJEKYLL=true

# GitHub Actions Integration
GITHUB_ACTIONS_ENABLED=true
GITHUB_ACTIONS_WORKFLOW=deploy-docs.yml

# Advanced
GITHUB_GIT_USER_NAME=NexusOS Deploy Bot
GITHUB_GIT_USER_EMAIL=deploy@nexusos.io
GITHUB_FORCE_PUSH=false
GITHUB_COMMIT_MESSAGE=Deploy documentation - %DATE%

# Analytics
GITHUB_PAGES_GOOGLE_ANALYTICS_ID=

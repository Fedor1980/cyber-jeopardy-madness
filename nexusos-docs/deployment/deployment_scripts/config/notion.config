# NexusOS Documentation Platform - Notion Configuration

# Notion Integration
NOTION_API_TOKEN=
NOTION_API_VERSION=2022-06-28
NOTION_DATABASE_ID=

# Deployment Options
NOTION_CREATE_PAGES=true
NOTION_UPDATE_EXISTING=true
NOTION_ARCHIVE_OLD=false

# Content Options
NOTION_INCLUDE_COVER_IMAGE=true
NOTION_COVER_IMAGE_URL=
NOTION_INCLUDE_ICON=true
NOTION_ICON_EMOJI=📚

# Properties
NOTION_DEFAULT_TAGS=Documentation,NexusOS
NOTION_STATUS_PROPERTY=Status
NOTION_DEFAULT_STATUS=Published

# Advanced
NOTION_BATCH_SIZE=10
NOTION_RATE_LIMIT_DELAY=0.5  # seconds between requests
NOTION_RETRY_FAILED=true

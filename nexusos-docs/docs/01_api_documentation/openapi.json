        ],
        "summary": "Deactivate user",
        "description": "Deactivate a user account",
        "operationId": "deleteUser",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^usr_[a-zA-Z0-9]+$"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "User deactivated successfully"
          }
        }
      }
    },

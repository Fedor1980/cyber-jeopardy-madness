{
  "openapi": "3.0.3",
  "info": {
    "title": "NexusOS API",
    "version": "1.0.0",
    "description": "The NexusOS API provides programmatic access to all platform features including\nagent management, user administration, workflow orchestration, and analytics.\n\n## Authentication\n\nThe API supports three authentication methods:\n- **API Keys**: Include in Authorization header as `Bearer {api_key}`\n- **OAuth 2.0**: Standard OAuth 2.0 flows with access tokens\n- **Service Accounts**: Client credentials flow for machine-to-machine\n\n## Rate Limiting\n\nRate limits vary by tier:\n- Free: 100 requests/hour\n- Standard: 1,000 requests/hour\n- Professional: 5,000 requests/hour\n- Enterprise: Custom limits\n\n## Support\n\n- Email: api-support@nexusos.io\n- Documentation: https://docs.nexusos.io\n- Status: https://status.nexusos.io\n",
    "contact": {
      "name": "NexusOS API Support",
      "email": "api-support@nexusos.io",
      "url": "https://nexusos.io/support"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://nexusos.io/terms"
    },
    "termsOfService": "https://nexusos.io/terms"
  },
  "servers": [
    {
      "url": "https://api.nexusos.io/v1",
      "description": "Production server"
    },
    {
      "url": "https://api-staging.nexusos.io/v1",
      "description": "Staging server"
    },
    {
      "url": "https://api-sandbox.nexusos.io/v1",
      "description": "Sandbox server (test environment)"
    }
  ],
  "tags": [
    {
      "name": "agents",
      "description": "AI agent management"
    },
    {
      "name": "users",
      "description": "User administration"
    },
    {
      "name": "workflows",
      "description": "Workflow orchestration"
    },
    {
      "name": "executions",
      "description": "Agent execution tracking"
    },
    {
      "name": "analytics",
      "description": "Analytics and reporting"
    },
    {
      "name": "workspaces",
      "description": "Workspace management"
    },
    {
      "name": "service-accounts",
      "description": "Service account management"
    },
    {
      "name": "webhooks",
      "description": "Webhook configuration"
    },
    {
      "name": "health",
      "description": "Service health checks"
    }
  ],
  "security": [

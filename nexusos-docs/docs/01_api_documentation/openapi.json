            }
          }
        }
      }
    },
    "/workflows/{workflowId}/trigger": {
      "post": {
        "tags": [
          "workflows"
        ],
        "summary": "Trigger workflow",
        "description": "Manually trigger a workflow execution",
        "operationId": "triggerWorkflow",
        "parameters": [
          {
            "name": "workflowId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^wfl_[a-zA-Z0-9]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "object",
                    "description": "Input data for the workflow"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Workflow triggered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "execution_id": {
                      "type": "string"
                    },
                    "workflow_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "triggered_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

{
  "name": "nexusos-documentation-platform",
  "version": "1.0.0",
  "description": "Complete documentation suite for NexusOS - API docs, admin manuals, training materials, diagrams, and deployment automation",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install",
    "lint": "markdownlint \"docs/**/*.md\" && cspell \"docs/**/*.md\"",
    "diagrams": "node build/render_diagrams.mjs",
    "html": "node build/render_html.mjs",
    "pdf": "node build/render_pdfs.mjs",
    "slides": "node build/render_slides.mjs",
    "index": "node build/search_indexer.mjs && node build/toc_generator.mjs",
    "audit": "python3 build/audit_content.py",
    "build": "npm run lint && npm run diagrams && npm run html && npm run pdf && npm run slides && npm run index",
    "validate": "bash deployment/deployment_scripts/scripts/validate_docs.sh",
    "package": "bash -c 'cd dist && zip -r nexusos_docs_v1.0.zip . -x \"*.DS_Store\"'",
    "clean": "rm -rf dist/* && mkdir -p dist/{html,pdf,diagrams,assets,slides}",
    "test": "npm run validate",
    "deploy": "bash deployment/deployment_scripts/deploy_all.sh",
    "deploy:dry-run": "DRY_RUN=true bash deployment/deployment_scripts/deploy_all.sh"
  },
  "keywords": [
    "documentation",
    "nexusos",
    "mermaid",
    "gitbook",
    "confluence",
    "training",
    "admin-manual",
    "api-documentation"
  ],
  "author": "NexusOS Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "^11.3.0",
    "marked": "^14.1.3",
    "js-yaml": "^4.1.0",
    "glob": "^11.0.0",
    "cheerio": "^1.0.0",
    "lunr": "^2.3.9",
    "gray-matter": "^4.0.3",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "markdownlint-cli": "^0.42.0",
    "cspell": "^8.14.4",
    "prettier": "^3.3.3",
    "@playwright/test": "^1.48.2"
  }
}
